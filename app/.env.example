# World IDKit (Developer Portal: https://developer.world.org)
# Persistent libSQL database. Local development can omit these and use file:otomo.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
NEXT_PUBLIC_WORLD_ENV=staging
# Reject births whose Selfie Check sybil_score exceeds this value (unset = log only)
WORLD_SYBIL_MAX=

# World ID for Agents (sandbox OIDC: https://sandbox.auth.world.org/portal)
AGENT_OIDC_ISSUER=https://sandbox.auth.world.org
AGENT_OIDC_CLIENT_ID=
AGENT_OIDC_CLIENT_SECRET=
AGENT_OIDC_REDIRECT_URI=http://localhost:3000/api/approval/callback

# Sepolia
SEPOLIA_RPC_URL=
OPERATOR_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
# 32-byte hex encryption key for independent companion wallets; keep stable and back up securely.
COMPANION_WALLET_KEY=
# Sepolia ETH sent to each new companion wallet at birth (gas for its own transactions)
COMPANION_GAS_ETH=0.02
ENS_PARENT_LABEL=otomo
ENS_USER_REGISTRY=
# true = grant the agent's mood setter inside the resolver initialize() calls (verify on Sepolia first)
ENS_GRANT_AGENT_IN_INIT=false

# Otomo Aqua stack on Sepolia — addresses from contracts/script/DeploySepolia.s.sol output (deployments/sepolia.json)
# USDC is the existing ENS MockUSDC (ENS_SEPOLIA.mockUsdc); only WETH is our own mock.
AQUA_ADDRESS=
AQUA_ROUTER_ADDRESS=
OTOMO_ORDER_BUILDER_ADDRESS=
MOCK_WETH_ADDRESS=

# LLM (OpenAI-compatible /chat/completions)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# HMAC key for the owner session cookie (generated by `npm run keys:init`)
APP_SECRET=

# TTS read-aloud (Gemini Interactions API). Unset TTS_MODEL = feature disabled (503).
# Reuses LLM_API_KEY. TTS_VOICE pins one Gemini prebuilt voice for all companions
# (unset = deterministic per-label voice). TTS_BASE_URL defaults to
# https://generativelanguage.googleapis.com
TTS_MODEL=
TTS_VOICE=
TTS_BASE_URL=

# Real-time voice conversation via Gemini Live (browser ↔ Gemini WebSocket with
# single-use ephemeral tokens; the real API key never reaches the client).
# Enabled whenever LLM_API_KEY is set. Defaults to gemini-3.8-live.
LIVE_MODEL=
