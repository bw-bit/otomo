# World IDKit (Developer Portal: https://developer.world.org)
# Persistent libSQL database. Local development can omit these and use file:otomo.db.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
NEXT_PUBLIC_WORLD_ENV=staging
# Reject births whose Selfie Check sybil_score exceeds this value (unset = log only)
WORLD_SYBIL_MAX=

# World ID for Agents (sandbox OIDC: https://sandbox.auth.world.org/portal)
AGENT_OIDC_ISSUER=https://sandbox.auth.world.org
AGENT_OIDC_CLIENT_ID=
AGENT_OIDC_CLIENT_SECRET=
AGENT_OIDC_REDIRECT_URI=http://localhost:3000/api/approval/callback

# Sepolia
SEPOLIA_RPC_URL=
OPERATOR_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
ENS_PARENT_LABEL=otomo
ENS_USER_REGISTRY=
# true = grant the agent's mood setter inside the resolver initialize() calls (verify on Sepolia first)
ENS_GRANT_AGENT_IN_INIT=false

# LLM (OpenAI-compatible /chat/completions)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# HMAC key for the owner session cookie (generated by `npm run keys:init`)
APP_SECRET=
